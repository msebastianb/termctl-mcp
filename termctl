#!/usr/bin/env python3
"""termctl - drives Terminal.app sessions with ONE command per action.

Built for an agent (even a small local model) that has to open, read and
write in a terminal session without hand-writing AppleScript: no
quotes to escape, no double "do script" to press Return, compact JSON output
on a single line.

  termctl list                          open sessions: id, tty, busy, title
  termctl info  <id> [-n 8]             identify a session: processes on the tty,
                                        cwd, size, last lines
  termctl status <id>                   idle? working? WAITING for an answer?
                                        (question + menu options, seconds motionless)
  termctl brief <id>                    rehydration in one call: which window it is,
                                        what we asked it, last output, state
  termctl search "text" [-n 3]          searches ALL sessions and says which one has it
  termctl read  <id> [-n 40]            last lines of that session
  termctl read  <id> --grep PATTERN     only the lines containing PATTERN
  termctl delta <id> [-n 60] [--reset]  ONLY the new lines since last time
  termctl send  <id> "text" [--wait-for P] [--timeout N]
                                        writes, presses Return and (with --wait-for) waits
                                        for the marker: one call instead of three
  termctl run   <id> "command" [-n 60]  sends, waits, returns exit code + output:
                                        one call instead of send+wait+read
  termctl choose <id> 2 | "Yes"          picks an entry of a TUI menu (arrows + Return)
  termctl key   <id> ctrl-c|up|esc|...  one single key (arrows and ctrl-* included)
  termctl new   [--preset P] [--cmd C] [--dir D]   opens a window and prints its id
  termctl title <id> "name"             renames the window: so `list` says which one it is
  termctl close <id> [--force]          closes the window (useful: don't pile up sessions)
  termctl watch <id> [-n 40] [--idle 4] [--timeout 120]   waits for the output to settle
  termctl wait-for <id> "pattern" [--timeout 300] [--interval 2]   waits for a marker
  termctl ask   "question" [--agent claude|copilot] [--model M] [--dir D]
                                        a direct question to a CLI agent, in a throwaway
                                        window (it closes itself)
  termctl presets                       lists the presets used by --preset
  termctl mcp                           MCP server on stdio: one tool per verb, so
                                        they can be switched on/off one at a time

Ready-made presets (the real list comes from `termctl presets`):
  copilot-opus   copilot --model claude-opus-5.5 --reasoning-effort high --autopilot
  copilot        copilot --autopilot
  claude         Claude Code, default model
  claude-opus    claude --model opus      (also claude-fable / claude-sonnet)
  copilot-yolo   copilot --autopilot --allow-all        <- no confirmation
  claude-yolo    claude --dangerously-skip-permissions  <- no confirmation
  shell          interactive shell in $HOME

Note on bytes: Terminal's do script ALWAYS appends a Return at the end of what
it writes. So one write = one Return, and key sequences are sent in
a single call (`choose` does that); `key` is for one single key at a time.
Arrows are sent in the form the session's TERM expects (for
xterm-256color it is ESC O B, not ESC [ B: the latter is ignored and the menu
stays still): it is read from the terminfo of the foreground process, --csi forces it.

Examples:
  termctl new --preset copilot-opus --title "copilot - my-project"
  termctl brief 512                            -> where we were, in one call
  termctl status 512                           -> {"state": "waiting_for_input", "question": "...", "options": [...]}
  termctl choose 512 2                         -> answers "2." of the menu and waits for a change
  termctl send 512 "add the tests for parse_config" --wait-for "Task complete" --timeout 900
  termctl delta 512                            -> only what showed up after
  termctl run 512 "git status --short"         -> {"exit_code": 0, "output": [...]}
  termctl search "Task complete"               -> {"found_in": 1, "sessions": [{"id": 512, ...}]}
  termctl info 512 / read 512 --grep "error" / key 512 ctrl-c / close 512
"""

import argparse
import hashlib
import io
import json
import os
import re
import shlex
import subprocess
import sys
import time

OSA = "/usr/bin/osascript"
US = "\x1f"
DEFAULT_LINES = 40
MAX_LINE_CHARS = 300
STATE = os.path.expanduser("~/.local/state/termctl-state.json")

PRESETS = {
    "copilot-opus": "copilot --model claude-opus-5.5 --reasoning-effort high --autopilot",
    "copilot": "copilot --autopilot",
    "copilot-yolo": "copilot --model claude-opus-5.5 --reasoning-effort high --autopilot --allow-all",
    "claude": "claude",
    "claude-opus": "claude --model opus",
    "claude-fable": "claude --model fable",
    "claude-sonnet": "claude --model sonnet",
    "claude-yolo": "claude --model opus --dangerously-skip-permissions",
    "shell": "exec $SHELL -l",
}

# Presets that remove EVERY confirmation: they exist, but are not used without telling the user.
YOLO_PRESETS = ("copilot-yolo", "claude-yolo")

# Recognised CLI agents (by process name / command line).
AGENTS = ("copilot", "claude", "codex", "opencode", "gemini", "aider", "cursor-agent")

# Text that means "I am not authenticated": it is reported, never fixed on our own.
LOGIN_HINTS = ("not logged in", "please run /login", "/login", "log in to", "sign in")

# int = single ASCII code; str = sequence after ESC (arrows & co.)
KEYS = {
    "ctrl-c": 3, "ctrl-d": 4, "ctrl-a": 1, "ctrl-e": 5, "ctrl-k": 11, "ctrl-l": 12,
    "ctrl-r": 18, "ctrl-u": 21, "ctrl-w": 23, "ctrl-x": 24, "ctrl-z": 26,
    "esc": 27, "enter": 13, "tab": 9, "shift-tab": "[Z", "backspace": 127, "space": 32,
    "up": "[A", "down": "[B", "right": "[C", "left": "[D",
}

SHELLS = {"zsh", "bash", "sh", "fish", "dash", "ksh", "tcsh", "nu", "login", "-zsh", "-bash"}

# Phrases that in a TUI mean "I am waiting for you to choose".
PROMPT_HINTS = (
    "enter to select", "to navigate", "esc to cancel", "to confirm", "↑/↓",
    "[y/n]", "[y/N]", "(y/n)", "(y/N)", "(Y/n)", "press any key", "press enter",
    "continue?", "are you sure", "do you want", "do you trust", "shall i",
    "allow?", "permission", "select an option", "choose an option", "input required",
    "waiting for", "your choice",
    # entries typical of agent CLIs (Claude Code, Copilot)
    "(esc)", "esc to interrupt", "ctrl+c to interrupt", "do you want to proceed",
    "don't ask again", "tell claude", "tell copilot", "allow once", "allow this",
    "allow command", "trust the files", "keep going",
)

# Markers of "this is the selected entry" (❯ in Claude Code, ▶ elsewhere).
MARKERS = "❯▶»●◉★✦"
OPT_RE = re.compile(r"^(\d+)[.)]\s+(.+)$")
BOX_CHARS = "│|╭╰─┌└╮╯╱╲┃"


def die(msg, **extra):
    print(json.dumps({"ok": False, "error": msg, **extra}, ensure_ascii=False))
    sys.exit(1)


def osa(script, timeout=45):
    """Runs AppleScript. On a permission error it prints the way out."""
    try:
        p = subprocess.run([OSA, "-e", script], capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        die(f"osascript did not answer within {timeout}s (Terminal busy or window blocked)")
    if p.returncode != 0:
        err = (p.stderr or "").strip()
        hint = None
        # macOS reports the Automation error in the system language: match both wordings.
        if ("-1743" in err or "not allowed" in err.lower()
                or "authorization" in err.lower() or "autorizzazione" in err.lower()):
            hint = ("missing the Automation permission for Terminal: System Settings > "
                    "Privacy & Security > Automation > (calling process) > Terminal")
        die(err or "osascript failed", hint=hint)
    return p.stdout.strip()


def astr(s):
    """Literal AppleScript string, correctly escaped."""
    out = s.replace("\\", "\\\\").replace('"', '\\"')
    return '"' + out.replace("\n", "\\n").replace("\r", "") + '"'


def _key_expr(v):
    if isinstance(v, int):
        return f"(ASCII character {v})"
    return f'((ASCII character 27) & {astr(v)})'


def _history(win_id, timeout=60):
    return osa(f'tell application "Terminal" to get history of tab 1 of window id {win_id}', timeout=timeout)


def _busy(win_id):
    try:
        return osa(f'tell application "Terminal" to get busy of tab 1 of window id {win_id}',
                   timeout=20).strip().lower() == "true"
    except SystemExit:
        return None


ARROW_CAPS = {"up": ("kcuu1", "[A"), "down": ("kcud1", "[B"),
              "left": ("kcub1", "[D"), "right": ("kcuf1", "[C")}
_TERM_CACHE = {}


def _osa_expr(data):
    """AppleScript expression that produces exactly these bytes."""
    return " & ".join(f"(ASCII character {b})" for b in data)


def _unescape_cap(val):
    """From \\EOB (infocmp notation) to the actual bytes."""
    out, i = bytearray(), 0
    val = val.strip().strip("'\"")
    simple = {"E": 27, "e": 27, "n": 10, "r": 13, "t": 9, "\\": 92, "a": 7, "b": 8, "f": 12, "v": 11}
    while i < len(val):
        c = val[i]
        if c == "\\" and i + 1 < len(val):
            n = val[i + 1]
            if n in simple:
                out.append(simple[n]); i += 2; continue
            if n.isdigit():
                j, num = i + 1, ""
                while j < len(val) and val[j].isdigit() and len(num) < 3:
                    num += val[j]; j += 1
                out.append(int(num, 8) & 0xFF); i = j; continue
            i += 2; continue
        if c == "^" and i + 1 < len(val):
            out.append(ord(val[i + 1].upper()) - 64); i += 2; continue
        out.extend(c.encode()); i += 1
    return bytes(out)


def _fg_term(win_id):
    """The TERM the foreground process of that session runs with."""
    try:
        tty = _window_meta(win_id)["tty"]
        procs = _procs_on_tty(tty)
        if not procs:
            return None
        out = subprocess.run(["ps", "eww", "-o", "command=", "-p", str(procs[-1]["pid"])],
                             capture_output=True, text=True, timeout=10,
                             stdin=subprocess.DEVNULL).stdout
    except Exception:
        return None
    m = re.search(r"\bTERM=([A-Za-z0-9._+-]+)", out)
    return m.group(1) if m else None


def _cap_bytes(term, cap):
    """The bytes terminfo expects for that capability (e.g. kcud1)."""
    if not term:
        return None
    key = (term, cap)
    if key in _TERM_CACHE:
        return _TERM_CACHE[key]
    data = None
    try:
        out = subprocess.run(["infocmp", "-1", term], capture_output=True, text=True,
                             timeout=10, stdin=subprocess.DEVNULL).stdout
        m = re.search(rf"^\s*{cap}=([^,]+),", out, re.M)
        if m:
            data = _unescape_cap(m.group(1))
    except Exception:
        data = None
    _TERM_CACHE[key] = data
    return data


def _key_data(win_id, name, force_csi=False):
    """(bytes, form) to send for a key.

    Arrows can NOT be hard-coded: for xterm-256color terminfo says
    kcud1=ESC O B (SS3 form) and a plain ESC [ B is ignored as a raw byte — a
    menu stays still and it looks like the arrow never arrived. So we read
    the TERM of the foreground process and use its form; --csi forces
    l'altra.
    """
    name = name.lower()
    if name in ARROW_CAPS:
        cap, fallback = ARROW_CAPS[name]
        if force_csi:
            return b"\x1b" + fallback.encode(), "csi (forced)"
        data = _cap_bytes(_fg_term(win_id), cap)
        if data:
            return data, f"terminfo ({_fg_term(win_id)})"
        return b"\x1b" + fallback.encode(), "csi (no terminfo)"
    if name not in KEYS:
        die(f"unsupported key: {name}", supported=sorted(KEYS))
    v = KEYS[name]
    return (bytes([v]) if isinstance(v, int) else b"\x1b" + v.encode()), "ascii"


def _press(win_id, name, force_csi=False):
    """One single key (carries a Return behind it: see _type)."""
    data, form = _key_data(win_id, name, force_csi)
    osa(f'tell application "Terminal" to do script {_osa_expr(data)} in tab 1 of window id {win_id}',
        timeout=60)
    return form


def clean_lines(raw, n):
    lines = [ln.rstrip() for ln in raw.splitlines()]
    while lines and not lines[-1].strip():
        lines.pop()
    total = len(lines)
    tail = lines[-n:] if n > 0 else lines
    trunc = [ln[:MAX_LINE_CHARS] for ln in tail]
    return total, trunc


def _no_markers(lines):
    return [ln for ln in lines if not re.search(r"__termctl_exit_\d+", ln)]


def _fingerprint(line):
    return hashlib.md5(line.strip().encode("utf-8", "replace")).hexdigest()[:8]


def _load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {}


def _save_state(state):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, STATE)
    except Exception:
        pass


def _touch_state(win_id, lines, total, title=None):
    """Remembers the last line seen and SINCE WHEN it has been there: that is "motionless for N seconds"."""
    state = _load_state()
    key = str(win_id)
    entry = state.get(key, {})
    fp = _fingerprint(lines[-1]) if lines else None
    if fp and fp != entry.get("last"):
        entry["last"] = fp
        entry["at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    entry["total_lines"] = total
    if title:
        entry["title"] = title
    state[key] = entry
    _save_state(state)
    return entry


def _remember_ask(win_id, kind, text, exit_code=None):
    """Keeps track of what we asked that session: used by `brief`."""
    state = _load_state()
    key = str(win_id)
    entry = state.get(key, {})
    asks = entry.get("asks", [])
    asks.append({"at": time.strftime("%H:%M:%S"), "kind": kind, "text": text[:200],
                 **({"exit_code": exit_code} if exit_code is not None else {})})
    entry["asks"] = asks[-6:]
    state[key] = entry
    _save_state(state)


def _quiet_seconds(win_id, lines):
    """How many seconds the last line has not changed (None if unknown)."""
    entry = _load_state().get(str(win_id), {})
    if not lines or not entry.get("at") or entry.get("last") != _fingerprint(lines[-1]):
        return None
    try:
        t = time.mktime(time.strptime(entry["at"], "%Y-%m-%dT%H:%M:%S"))
        return int(time.time() - t)
    except Exception:
        return None


def _plain(line):
    """(text, was_selected): strips the borders and the selection marker."""
    t = line.strip().strip(BOX_CHARS).strip()
    sel = bool(t) and t[0] in MARKERS
    if sel:
        t = t[1:].strip()
    return t, sel


def _detect_prompt(lines):
    """Recognises a TUI waiting for a choice: question + menu entries."""
    pairs = [_plain(x) for x in lines[-25:]]
    tail = [(t, sel) for t, sel in pairs if t]
    # selection marker on an empty line = the input box of a TUI waiting
    # for input (e.g. Copilot after "Task complete", Claude Code): it is not a menu,
    # but the agent is parked there and waiting for an instruction.
    idle_prompt = any(sel and not t for t, sel in pairs[-4:])
    opts, hints = [], []
    for t, sel in tail:
        m = OPT_RE.match(t)
        if m:
            label = m.group(2).strip()
            if label:
                opts.append({"n": int(m.group(1)), "text": label[:100], "selected": sel})
        low = t.lower()
        if any(h.lower() in low for h in PROMPT_HINTS):
            hints.append(t[:120])
    plain = [t for t, _sel in tail]
    question = None
    for t in reversed(plain):
        if OPT_RE.match(t) or any(h.lower() in t.lower() for h in PROMPT_HINTS):
            continue
        if t[-1:] in "?:":
            question = t[:200]
            break
    if question is None:
        for t in plain:
            if OPT_RE.match(t) or any(h.lower() in t.lower() for h in PROMPT_HINTS):
                continue
            question = t[:200]
            break
    waiting = bool(opts) or bool(hints)
    return {"waiting_for_input": waiting,
            "question": question if waiting else None,
            "options": opts if waiting else [],
            "selected": next((i for i, o in enumerate(opts) if o.get("selected")), None),
            "idle_prompt": idle_prompt,
            "hints": hints[-2:]}


def _agent_of(procs):
    """Recognises a CLI agent from the processes of that session."""
    for p in procs or []:
        low = p["command"].lower()
        for a in AGENTS:
            if re.search(rf"(?:^|[\s/@-]){re.escape(a)}(?:[\s/-]|$)", low):
                return a
    return None


def _login_required(lines):
    low = "\n".join(lines[-25:]).lower()
    return any(h in low for h in LOGIN_HINTS)


def _tui_note(agent):
    return (f"{agent} TUI: `busy` is the program, not the work — to know whether it is "
            "working, look at quiet_s and waiting_for_input")


def _state_label(busy, waiting):
    if busy and waiting:
        return "waiting_for_input"
    if busy:
        return "working"
    if waiting:
        return "idle_at_prompt"
    return "ready"


def sessions_list():
    """Every Terminal.app window: id, tty, busy, title."""
    raw = osa('''
tell application "Terminal"
    set out to ""
    repeat with w in windows
        set t to tab 1 of w
        set out to out & (id of w as text) & (ASCII character 31) & (tty of t) & (ASCII character 31) & (busy of t as text) & (ASCII character 31) & (name of w as text) & linefeed
    end repeat
    return out
end tell
''')
    sessions = []
    for ln in raw.splitlines():
        parts = ln.split(US)
        if len(parts) >= 4:
            sessions.append({"id": int(parts[0]), "tty": parts[1],
                             "busy": parts[2].strip().lower() == "true",
                             "title": parts[3][:120]})
    return sessions


def _window_meta(win_id):
    raw = osa(f'''
tell application "Terminal"
    set w to window id {win_id}
    set t to tab 1 of w
    return (tty of t) & (ASCII character 31) & (busy of t as text) & (ASCII character 31) & (name of w as text) & (ASCII character 31) & (number of rows of t as text) & (ASCII character 31) & (number of columns of t as text)
end tell
''')
    parts = raw.split(US)
    return {"tty": parts[0], "busy": parts[1].strip().lower() == "true",
            "title": parts[2][:120], "rows": int(parts[3]) if len(parts) > 3 else 0,
            "cols": int(parts[4]) if len(parts) > 4 else 0}


def _window_exists(win_id):
    try:
        return any(s["id"] == win_id for s in sessions_list())
    except SystemExit:
        return False


def _procs_on_tty(tty):
    """Processes with that terminal as stdin: who is running inside it."""
    name = tty.replace("/dev/", "")
    try:
        p = subprocess.run(["ps", "-t", name, "-o", "pid=,ppid=,etime=,command="],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return []
    out = []
    for ln in p.stdout.splitlines():
        parts = ln.strip().split(None, 3)
        if len(parts) == 4 and parts[0].isdigit():
            out.append({"pid": int(parts[0]), "ppid": int(parts[1]),
                        "etime": parts[2], "command": parts[3][:140]})
    return out


def _cwd_of(pid):
    try:
        p = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    for ln in p.stdout.splitlines():
        if ln.startswith("n"):
            return ln[1:]
    return None


def _type(win_id, text):
    """Writes the text into the session (which executes it: Terminal adds the CR).

    Terminal's `do script` ALWAYS appends a newline at the end of what
    it writes (verified with a byte probe: after every write a
    0d arrives), and there is no way around it: System Events is blocked by permissions
    ("not allowed to send keystrokes", 1002) and writing to the tty device sends
    the bytes to the session's DISPLAY, not to the program's stdin. So:
    one write = one Return, and key sequences are sent in ONE single
    call (`choose` does that); `key` is fine for one key at a time.
    """
    osa(f'tell application "Terminal" to do script {astr(text)} in tab 1 of window id {win_id}', timeout=60)


def _enter(win_id, wait=0.0):
    """Presses Return: a do script with empty text is a single CR."""
    if wait:
        time.sleep(wait)
    osa(f'tell application "Terminal" to do script "" in tab 1 of window id {win_id}', timeout=60)


def _snapshot(win_id):
    """(meta, procs, fg, lines, total, detection, agent) in one go."""
    meta = _window_meta(win_id)
    procs = _procs_on_tty(meta["tty"])
    fg = procs[-1] if procs else None
    raw = _history(win_id)
    total, lines = clean_lines(raw, 0)
    return meta, procs, fg, lines, total, _detect_prompt(lines), _agent_of(procs)


def cmd_list(_args):
    sessions = sessions_list()
    print(json.dumps({"ok": True, "count": len(sessions), "sessions": sessions}, ensure_ascii=False))
    return sessions


def cmd_info(args):
    """Identifies a session without reading the whole scrollback."""
    meta, procs, fg, lines, total, _det, agent = _snapshot(args.id)
    _touch_state(args.id, lines, total, meta["title"])
    print(json.dumps({
        "ok": True, "id": args.id, "tty": meta["tty"], "busy": meta["busy"],
        "title": meta["title"], "size": f'{meta["cols"]}x{meta["rows"]}',
        "agent": agent,
        "foreground": fg, "processes": procs[:6], "cwd": _cwd_of(fg["pid"]) if fg else None,
        "total_lines": total, "shown": len(lines[-args.lines:]),
        "last_lines": _no_markers(lines[-args.lines:]),
    }, ensure_ascii=False))


def cmd_status(args):
    """Working, parked at the prompt, or WAITING for an answer?"""
    meta, _procs, fg, lines, total, det, agent = _snapshot(args.id)
    quiet = _quiet_seconds(args.id, lines)
    _touch_state(args.id, lines, total, meta["title"])
    waiting = det["waiting_for_input"] or bool(agent and det.get("idle_prompt"))
    label = _state_label(meta["busy"], waiting)
    out = {"ok": True, "id": args.id, "state": label, "busy": meta["busy"],
           "waiting_for_input": waiting, "question": det["question"],
           "options": det["options"], "selected": det.get("selected"), "quiet_s": quiet,
           "idle_prompt": bool(det.get("idle_prompt")),
           "title": meta["title"], "agent": agent,
           "foreground": fg, "cwd": _cwd_of(fg["pid"]) if fg else None,
           "last_lines": _no_markers(lines[-args.lines:])}
    if det["hints"]:
        out["hints"] = det["hints"]
    if _login_required(lines):
        out["login_required"] = True
        out["note"] = ("the agent is not authenticated: it needs /login, do it yourself "
                       "(I do not try credentials)")
    elif agent and det.get("idle_prompt") and not det["options"]:
        out["note"] = (f"{agent} is parked on its input box: it finished and waits for "
                       "an instruction (it is not a menu to choose from)")
    elif label == "waiting_for_input" and not det["options"]:
        out["note"] = ("it looks like it waits for an answer but I see no numbered menu: "
                       "read the last lines and decide yourself")
    elif label == "working" and quiet is not None and quiet > args.stuck:
        out["note"] = (f"busy but motionless for {quiet}s: it may be blocked "
                       "(network, prompt off screen) — look with read")
    elif agent:
        out["note"] = _tui_note(agent)
    print(json.dumps(out, ensure_ascii=False))


def cmd_brief(args):
