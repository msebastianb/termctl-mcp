def _audit(argv):
    """Records who invoked termctl: used to verify that an agent really uses it."""
    try:
        d = os.path.expanduser("~/.local/state")
        os.makedirs(d, exist_ok=True)
        ppid = os.getppid()
        parent = "?"
        try:
            parent = subprocess.run(["ps", "-o", "command=", "-p", str(ppid)],
                                    capture_output=True, text=True, timeout=5).stdout.strip()[:140]
        except Exception:
            pass
        with open(os.path.join(d, "termctl.log"), "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} termctl {' '.join(argv)} | parent={parent}\n")
    except Exception:
        pass


# ---------------------------------------------------------------------------
# MCP server (stdio): one tool per verb, so they can be switched on and off one at
# a time with `hermes tools enable/disable termctl:<verb>`. It reimplements
# nothing: it calls the same cmd_* of the CLI and captures their JSON.
# ---------------------------------------------------------------------------

MCP_PROTOCOL = "2024-11-05"
_I, _S = {"type": "integer"}, {"type": "string"}


def _ns(**kw):
    return argparse.Namespace(**kw)


def _schema(props, required=()):
    return {"type": "object", "properties": props, "required": list(required)}


def _as_list(v):
    return v if isinstance(v, list) else [str(v)]


# name -> (description, schema, argument builder, function)
MCP_TOOLS = {}


def _tool(name, desc, schema, build, func):
    MCP_TOOLS[name] = {"description": desc, "inputSchema": schema, "build": build, "func": func}


_tool("list", "Open Terminal.app windows (id, tty, busy, title).", _schema({}),
      lambda a: _ns(), cmd_list)
_tool("brief", "Which session an id is, what we asked it, state, last output.",
      _schema({"id": _I, "lines": _I}, ["id"]),
      lambda a: _ns(id=int(a["id"]), lines=int(a.get("lines", 15))), cmd_brief)
_tool("status", "Working, parked at the prompt, or waiting for an answer? Gives question and options.",
      _schema({"id": _I, "lines": _I, "stuck": _I}, ["id"]),
      lambda a: _ns(id=int(a["id"]), lines=int(a.get("lines", 10)), stuck=int(a.get("stuck", 120))),
      cmd_status)
_tool("info", "Session details: processes on the tty, cwd, agent, last lines.",
      _schema({"id": _I, "lines": _I}, ["id"]),
      lambda a: _ns(id=int(a["id"]), lines=int(a.get("lines", 8))), cmd_info)
_tool("search", "Searches a text in every session and says which one has it.",
