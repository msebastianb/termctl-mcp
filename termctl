def cmd_search(args):
    """Searches a text in every session: says which window it is in."""
    pat = args.pattern.lower()
    sessions = sessions_list()
    found = []
    for s in sessions:
        try:
            raw = _history(s["id"])
        except SystemExit:
            continue
        total, lines = clean_lines(raw, 0)
        lines = _no_markers(lines)
        hits = [ln for ln in lines if pat in ln.lower()]
        if hits:
            found.append({"id": s["id"], "busy": s["busy"], "title": s["title"][:90],
                          "tty": s["tty"], "matches": len(hits), "samples": hits[-args.lines:]})
    out = {"ok": True, "pattern": args.pattern, "searched": len(sessions),
           "found_in": len(found), "sessions": found}
    if not found:
        out["note"] = ("no session contains that text: it may be outside the lines "
                       "kept in the scrollback, or it has not shown up yet")
    print(json.dumps(out, ensure_ascii=False))


def cmd_read(args):
    raw = _history(args.id)
    total, all_lines = clean_lines(raw, 0)
    _touch_state(args.id, all_lines, total)
    all_lines = _no_markers(all_lines)
    out = {"ok": True, "id": args.id, "busy": _busy(args.id), "total_lines": total}
    if args.grep:
        pat = args.grep.lower()
        idx = [i for i, ln in enumerate(all_lines) if pat in ln.lower()]
        shown, used = [], set()
        for i in idx[-args.lines:]:
            for j in range(max(0, i - args.context), min(len(all_lines), i + args.context + 1)):
                if j not in used:
                    used.add(j)
                    shown.append(all_lines[j])
        out.update({"grep": args.grep, "matches": len(idx), "shown": len(shown), "lines": shown})
    else:
        shown = all_lines[-args.lines:]
        out.update({"shown": len(shown), "lines": shown})
    print(json.dumps(out, ensure_ascii=False))


def cmd_delta(args):
    """Only the new lines since the last read of that window.

    Think of a loop: wait-for -> delta -> send -> delta. Each delta pays only
    what showed up after, instead of paying for the whole scrollback again.
    """
    raw = _history(args.id)
    total, lines = clean_lines(raw, 0)
    prev = _load_state().get(str(args.id))
    new, note = [], None

    if args.reset or not prev or not lines:
        new = lines[-args.lines:]
        note = "first read of this session (or --reset): starting lines, not a delta"
    else:
        anchor = prev.get("last")
        idx = next((i for i, ln in enumerate(lines) if _fingerprint(ln) == anchor), None)
        if idx is None:
            new = lines[-args.lines:]
            note = ("I cannot find the last line read (the scrollback scrolled or the window "
                    "was reused): here are the last lines")
        else:
            new = lines[idx + 1:]
    clean = _no_markers(new)
    inner = len(new) - len(clean)          # service lines of `run`, not content
    shown = clean[-args.lines:]
    if len(shown) < len(clean):
        extra = f"{len(clean) - len(shown)} more lines: raise -n to see them all"
        note = f"{note} | {extra}" if note else extra
    _touch_state(args.id, lines, total)
    out = {"ok": True, "id": args.id, "busy": _busy(args.id), "total_lines": total,
           "new_lines": len(new), "shown": len(shown), "lines": shown}
    if inner:
        out["filtered_internal_lines"] = inner
    if note:
        out["note"] = note
    print(json.dumps(out, ensure_ascii=False))


def cmd_send(args):
    text = " ".join(args.text)
    raw0 = _history(args.id)
    total0, lines0 = clean_lines(raw0, 0)
    _type(args.id, text)
    _remember_ask(args.id, "send", text)
    out = {"ok": True, "id": args.id, "sent": text[:200], "enter": True}
    if args.no_enter:
        out["note"] = ("--no-enter cannot be supported: do script always appends a Return, "
                       "the text has been sent and executed")
    if args.wait_for:
        started = time.time()
        deadline = started + args.timeout
        matched, rawN = False, raw0
        while True:
            rawN = _history(args.id)
            _t, linesNow = clean_lines(rawN, 0)
            fresh = linesNow[len(lines0):] if len(linesNow) >= len(lines0) else linesNow
            if any(args.wait_for.lower() in l.lower() for l in fresh):
                matched = True
                break
            if time.time() >= deadline:
                break
            time.sleep(args.interval)
        totalN, linesN = clean_lines(rawN, 0)
        new = linesN[len(lines0):] if len(linesN) >= len(lines0) else linesN[-args.lines:]
        new = _no_markers(new)
        _touch_state(args.id, linesN, totalN)
        out.update({"matched": matched, "pattern": args.wait_for,
                    "waited_s": round(time.time() - started, 1), "busy": _busy(args.id),
                    "new_lines": len(new), "lines": new[-args.lines:]})
        if not matched:
            out["note"] = (f"marker did not appear within {args.timeout}s: that does NOT mean it is "
                           "finished, raise --timeout or look with status")
    print(json.dumps(out, ensure_ascii=False))


def cmd_run(args):
    """Sends a command, waits for it to finish, returns the exit code and ONLY its output.

    One call instead of send + wait-for + read. It assumes that session
    runs a shell prompt (not a TUI): if something else runs there,
    the command would end up on the wrong stdin, so it refuses and says so.
    """
    cmd = " ".join(args.cmd).replace("\n", " ").strip()
    if not cmd:
        die("empty command")
    meta = _window_meta(args.id)
    procs = _procs_on_tty(meta["tty"])
    fg = procs[-1] if procs else None
    fg_name = os.path.basename((fg or {}).get("command", "").split()[0]) if fg else ""
    if fg_name not in SHELLS:
        die(f"session {args.id} is not at a shell prompt: it runs "
            f"'{fg_name or '?'}'",
            foreground=fg,
            hint="for a TUI use send/read/wait-for; for a shell: termctl new --preset shell")

    marker = f"__termctl_exit_{int(time.time() * 1000)}"
    payload = f'{cmd}; echo "{marker}=$?"'
    _type(args.id, payload)

    started = time.time()
    deadline = started + args.timeout
    exit_code, lines = None, []
    while True:
        raw = _history(args.id)
        total, lines = clean_lines(raw, 0)
        hit = None
        for ln in lines:
            m = re.search(marker + r"=(\d+)", ln)
            if m:
                hit = m
        if hit:
            exit_code = int(hit.group(1))
            break
        if time.time() >= deadline:
            break
        time.sleep(1.0)

    waited = round(time.time() - started, 1)
    _remember_ask(args.id, "run", cmd, exit_code)
    if exit_code is None:
        _touch_state(args.id, lines, total, meta["title"])
        print(json.dumps({"ok": True, "id": args.id, "cmd": cmd, "exit_code": None,
                          "waited_s": waited, "busy": _busy(args.id),
                          "note": f"no end marker within {args.timeout}s: the command "
                                  "may still be running (raise --timeout)",
                          "lines": _no_markers(lines[-args.lines:])}, ensure_ascii=False))
        return

    first = next((i for i, ln in enumerate(lines) if marker in ln), None)
    last = next((i for i, ln in enumerate(lines) if re.search(marker + r"=(\d+)", ln)), None)
    out_lines = lines[first + 1:last] if (first is not None and last is not None and last > first) else []
    out_lines = _no_markers(out_lines)
    shown = out_lines[-args.lines:]
    _touch_state(args.id, lines, total, meta["title"])
    out = {"ok": True, "id": args.id, "cmd": cmd, "exit_code": exit_code,
           "waited_s": waited, "output_lines": len(out_lines), "shown": len(shown),
           "output": shown}
    if len(shown) < len(out_lines):
        out["note"] = f"{len(out_lines) - len(shown)} more output lines: raise -n"
    if not out_lines:
        out["note"] = "command ran without output (or echo disabled in the shell)"
    print(json.dumps(out, ensure_ascii=False))


def cmd_choose(args):
    """Picks an entry of a TUI menu: arrows + Return, then waits for the screen to change.

    Explicit: the agent decides (entry number or text), there is no
    automatic go-ahead. If it sees no menu, it presses nothing and says so.
    """
    want = " ".join(args.what)
    meta, _procs, _fg, lines, total, det, agent = _snapshot(args.id)
    opts = det["options"]
    if not opts:
        die("in this session I see no numbered menu to choose from",
            question=det.get("question"), last_lines=_no_markers(lines[-8:]),
            hint="look with status/read: if it is a TUI without a menu use send or key")
    target = None
    if want.isdigit():
        n = int(want)
        target = next((i for i, o in enumerate(opts) if o["n"] == n), None)
        if target is None and 1 <= n <= len(opts):
            target = n - 1
    else:
        target = next((i for i, o in enumerate(opts) if want.lower() in o["text"].lower()), None)
    if target is None:
        die(f"no entry matches '{want}'", options=opts)

    # ONE single write: the arrows, and the Return Terminal appends itself confirms.
    # Sending them one per call would fire the Return after the first arrow
    # (that is the bug that always picked the first entry of the menu).
    # Where does the selection start? Agent menus mark the current entry (❯):
    # without knowing that you would count arrows from the first entry and pick the wrong one.
    start = det.get("selected")
    start = start if isinstance(start, int) else 0
    delta = target - start
    if delta == 0:
        _enter(args.id)
        form = "no arrow"
    else:
        key_name = "down" if delta > 0 else "up"
        data, form = _key_data(args.id, key_name, args.csi)
        osa(f'tell application "Terminal" to do script {_osa_expr(data * abs(delta))} in tab 1 of window id {args.id}',
            timeout=60)
    _remember_ask(args.id, "choose", f"{opts[target]['n']}. {opts[target]['text']}")

    started = time.time()
    deadline = started + args.timeout
    changed, last_fp = False, _fingerprint(lines[-1]) if lines else None
    while True:
        _m, _p, _f, lines2, total2, _d, _a = _snapshot(args.id)
        if lines2 and _fingerprint(lines2[-1]) != last_fp:
            changed = True
            break
        if time.time() >= deadline:
            break
        time.sleep(1.0)
    _touch_state(args.id, lines2, total2, meta["title"])
    out = {"ok": True, "id": args.id, "chosen": opts[target]["text"],
           "chosen_number": opts[target]["n"], "screen_changed": changed, "arrow_form": form,
           "from_selected": start, "moved": delta, "agent": agent,
           "waited_s": round(time.time() - started, 1), "busy": _busy(args.id),
           "last_lines": _no_markers(lines2[-8:])}
    if not changed:
        out["note"] = ("the screen did not change: the choice may not have landed, "
                       "retry or look with read")
    print(json.dumps(out, ensure_ascii=False))


