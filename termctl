def cmd_close(args):
    """Closes a window without a dialog popping up on the desktop.

    If a TUI runs inside (`busy`), without --force it does NOT kill it: it just says so.
    With --force it terminates the processes of that tty (so Terminal does not ask for a
    confirmation) and then the window goes away by itself.
    """
    if not _window_exists(args.id):
        die(f"no window with id {args.id}")
    meta = _window_meta(args.id)
    tty = meta["tty"]
    method = None
    if meta["busy"]:
        try:                                    # try to exit the shell cleanly
            _type(args.id, "exit")
        except SystemExit:
            pass
        for _ in range(6):
            if not _busy(args.id):
                break
            time.sleep(1)
    if not _busy(args.id):
        osa(f'tell application "Terminal" to close window id {args.id} saving no', timeout=30)
        method = "closed"
    elif not args.force:
        print(json.dumps({"ok": True, "id": args.id, "closed": False, "busy": True,
                          "tty": tty,
                          "note": "there is an active process inside (a TUI does not answer exit): "
                                  "close it yourself, or call again with --force to terminate it",
                          "processes": _procs_on_tty(tty)[:4]}, ensure_ascii=False))
        return
    else:
        procs = _procs_on_tty(tty)
        for p in procs:
            try:
                os.kill(p["pid"], 15)
            except Exception:
                pass
        for _ in range(5):
            if not _procs_on_tty(tty):
                break
            time.sleep(1)
        for p in _procs_on_tty(tty):
            try:
                os.kill(p["pid"], 9)
            except Exception:
                pass
        for _ in range(5):
            if not _window_exists(args.id):
                break
            time.sleep(1)
        if _window_exists(args.id):
            osa(f'tell application "Terminal" to close window id {args.id} saving no', timeout=30)
            method = "closed"
        else:
            method = "terminated"
    time.sleep(0.5)
    gone = not _window_exists(args.id)
    if gone:
        state = _load_state()
        state.pop(str(args.id), None)
        _save_state(state)
    print(json.dumps({"ok": True, "id": args.id, "closed": gone,
                      "method": method, "tty": tty}, ensure_ascii=False))


def cmd_watch(args):
    deadline = time.time() + args.timeout
    last, stable_since, total, tail = None, None, 0, []
    while True:
        raw = _history(args.id)
        total, tail = clean_lines(raw, args.lines)
        if raw == last:
            if stable_since is None:
                stable_since = time.time()
            elif time.time() - stable_since >= args.idle:
                break
        else:
            stable_since = None
            last = raw
        if time.time() >= deadline:
            break
        time.sleep(2)
    _touch_state(args.id, tail, total)
    print(json.dumps({"ok": True, "id": args.id, "busy": _busy(args.id),
                      "stable": stable_since is not None, "total_lines": total,
                      "lines": _no_markers(tail)}, ensure_ascii=False))


def cmd_wait_for(args):
    """Waits for a marker to appear in the scrollback (e.g. 'Task complete').

    More reliable than a sleep: it returns as soon as the marker is there, and on timeout it
    says so (`matched: false`) instead of letting you believe it finished.
    """
    started = time.time()
    deadline = started + args.timeout
    raw = ""
    while True:
        raw = _history(args.id)
        if args.pattern.lower() in raw.lower():
            total, tail = clean_lines(raw, args.lines)
            _touch_state(args.id, tail, total)
            print(json.dumps({"ok": True, "id": args.id, "matched": True, "pattern": args.pattern,
                              "waited_s": round(time.time() - started, 1), "busy": _busy(args.id),
                              "total_lines": total, "shown": len(tail),
                              "lines": _no_markers(tail)}, ensure_ascii=False))
            return
        if time.time() >= deadline:
            total, tail = clean_lines(raw, args.lines)
            _touch_state(args.id, tail, total)
            print(json.dumps({"ok": True, "id": args.id, "matched": False, "pattern": args.pattern,
                              "waited_s": round(time.time() - started, 1), "busy": _busy(args.id),
                              "note": "marker did not appear within the timeout: the session is NOT necessarily "
                                      "finished, raise --timeout or read with read",
                              "total_lines": total, "shown": len(tail),
                              "lines": _no_markers(tail)}, ensure_ascii=False))
            return
        time.sleep(args.interval)


def cmd_ask(args):
    """A prompt to a CLI agent, in a throwaway window, in one call.

    Opens a shell session, runs the one-shot (`claude -p` / `copilot -p`),
    takes exit code and output and closes the window: for a direct question you
    do not need to keep a TUI around, and sessions do not pile up.
    Authentication is not improvised: if the agent says it is not
    authenticated, that is reported as is (the user does the /login).
    """
    prompt = " ".join(args.prompt).replace("\n", " ").strip()
    if not prompt:
        die("prompt vuoto")
    me = os.path.abspath(__file__)

    def call(*a, **kw):
        to = kw.get("timeout", 900)
        try:
            proc = subprocess.run([sys.executable, me, *a], capture_output=True, text=True,
                                  timeout=to, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return {"ok": False, "error": f"timeout after {to}s"}
        lines = (proc.stdout or "").strip().splitlines()
        try:
            return json.loads(lines[-1]) if lines else {"ok": False,
                                                        "error": (proc.stderr or "")[:200]}
        except Exception:
            return {"ok": False, "error": (proc.stdout or "")[-200:]}

    new_args = ["new", "--preset", "shell", "--title", f"termctl ask ({args.agent})"]
    if args.dir:
        new_args += ["--dir", args.dir]
    win = call(*new_args, timeout=120)
    if not win.get("id"):
        print(json.dumps({"ok": False, "error": "could not open the session", "detail": win},
                         ensure_ascii=False))
        return
    wid = str(win["id"])
    cmd = f"{args.agent} -p " + shlex.quote(prompt)
    if args.model:
        cmd += " --model " + shlex.quote(args.model)
    if args.agent == "copilot" and args.reasoning:
        cmd += " --reasoning-effort " + shlex.quote(args.reasoning)
    res = call("run", wid, cmd, "--timeout", str(int(args.timeout)), timeout=args.timeout + 120)
    closed = None
    if not args.keep:
        closed = call("close", wid, "--force", timeout=90).get("closed")
    out = {"ok": bool(res.get("ok")), "agent": args.agent, "model": args.model or "(default)",
           "cmd": cmd, "exit_code": res.get("exit_code"), "waited_s": res.get("waited_s"),
           "output": res.get("output", []), "window": win.get("id"), "window_closed": closed}
    low = " ".join(out["output"]).lower()
    if "not logged in" in low or "/login" in low:
        out["login_required"] = True
        out["note"] = ("the agent is not authenticated: it needs /login, do it yourself "
                       "(I do not try credentials)")
    elif res.get("note"):
        out["note"] = res["note"]
    print(json.dumps(out, ensure_ascii=False))


