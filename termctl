def _run_captured(func, ns):
    """Runs a verb capturing its JSON: stdout stays JSON-RPC only."""
    buf, old = io.StringIO(), sys.stdout
    sys.stdout = buf
    try:
        func(ns)
    except SystemExit:                    # die() prints the error and calls sys.exit
        pass
    except Exception as e:
        sys.stdout = old
        return json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}, ensure_ascii=False)
    finally:
        sys.stdout = old
    lines = [l for l in buf.getvalue().strip().splitlines() if l.strip()]
    return lines[-1] if lines else json.dumps({"ok": False, "error": "no output"},
                                              ensure_ascii=False)


def _mcp_write(obj):
    sys.__stdout__.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.__stdout__.flush()


def _mcp_result(mid, text, is_error=False):
    _mcp_write({"jsonrpc": "2.0", "id": mid,
                "result": {"content": [{"type": "text", "text": text}], "isError": is_error}})


def cmd_mcp(_args):
    """MCP server on stdio (one JSON-RPC message per line). In stdout ONLY MCP messages."""
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        try:
            msg = json.loads(raw)
        except Exception:
            continue
        mid, method = msg.get("id"), msg.get("method", "")
        if method == "initialize":
            ver = (msg.get("params") or {}).get("protocolVersion") or MCP_PROTOCOL
            _mcp_write({"jsonrpc": "2.0", "id": mid, "result": {
                "protocolVersion": ver,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": "termctl", "version": "1.0.0"}}})
        elif method in ("notifications/initialized", "initialized"):
            continue
        elif method == "ping":
            _mcp_write({"jsonrpc": "2.0", "id": mid, "result": {}})
        elif method == "tools/list":
            _mcp_write({"jsonrpc": "2.0", "id": mid, "result": {"tools": [
                {"name": n, "description": t["description"], "inputSchema": t["inputSchema"]}
                for n, t in MCP_TOOLS.items()]}})
        elif method == "tools/call":
            params = msg.get("params") or {}
            name, args = params.get("name"), (params.get("arguments") or {})
            if name not in MCP_TOOLS:
                _mcp_write({"jsonrpc": "2.0", "id": mid,
                            "error": {"code": -32602, "message": f"unknown tool: {name}"}})
                continue
            tool = MCP_TOOLS[name]
            _audit(["mcp:call", str(name)])      # tracks who uses what, also over MCP
            try:
                ns = tool["build"](args)
            except (KeyError, TypeError, ValueError) as e:
                _mcp_result(mid, json.dumps({"ok": False, "error": f"invalid arguments: {e}"},
                                            ensure_ascii=False), True)
                continue
            out = _run_captured(tool["func"], ns)
            try:
                is_err = not json.loads(out).get("ok", False)
            except Exception:
                is_err = True
            _mcp_result(mid, out, is_err)
        elif mid is not None:
            _mcp_write({"jsonrpc": "2.0", "id": mid,
                        "error": {"code": -32601, "message": f"unsupported method: {method}"}})
    return 0


def main():
    if not os.path.exists(OSA):
        die("osascript not found")
    _audit(sys.argv[1:])
    p = argparse.ArgumentParser(prog="termctl", description="drives Terminal.app with one command per action")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list").set_defaults(func=cmd_list)
    sub.add_parser("mcp", help="MCP server on stdio (for `hermes mcp add`)").set_defaults(func=cmd_mcp)
    sub.add_parser("presets").set_defaults(func=cmd_presets)

    i = sub.add_parser("info", help="identify a session: processes, cwd, last lines")
    i.add_argument("id", type=int)
    i.add_argument("-n", "--lines", type=int, default=8)
    i.set_defaults(func=cmd_info)

    st = sub.add_parser("status", help="working / idle / waiting for an answer?")
    st.add_argument("id", type=int)
    st.add_argument("-n", "--lines", type=int, default=10)
    st.add_argument("--stuck", type=int, default=120, help="seconds after which it is reported as 'stuck'")
    st.set_defaults(func=cmd_status)

    br = sub.add_parser("brief", help="rehydration: what this session is and where it was")
    br.add_argument("id", type=int)
    br.add_argument("-n", "--lines", type=int, default=15)
    br.set_defaults(func=cmd_brief)

    f = sub.add_parser("search", help="searches a text in every session")
    f.add_argument("pattern")
    f.add_argument("-n", "--lines", type=int, default=3, help="example lines per session")
    f.set_defaults(func=cmd_search)

    r = sub.add_parser("read")
    r.add_argument("id", type=int)
    r.add_argument("-n", "--lines", type=int, default=DEFAULT_LINES)
    r.add_argument("--grep", help="shows only the lines containing this text")
    r.add_argument("-C", "--context", type=int, default=2,
                   help="context lines around every --grep match (default 2)")
    r.set_defaults(func=cmd_read)

    d = sub.add_parser("delta", help="only the new lines since the last read")
    d.add_argument("id", type=int)
    d.add_argument("-n", "--lines", type=int, default=60)
    d.add_argument("--reset", action="store_true", help="forgets the resume point")
    d.set_defaults(func=cmd_delta)

    s = sub.add_parser("send")
    s.add_argument("id", type=int)
    s.add_argument("text", nargs="+")
    s.add_argument("-n", "--lines", type=int, default=DEFAULT_LINES)
    s.add_argument("--no-enter", action="store_true")
    s.add_argument("--wait", type=float, default=2.0, help="pause before the Return (default 2s)")
    s.add_argument("--wait-for", help="after the Return, waits for this marker (one single call)")
    s.add_argument("--timeout", type=float, default=600.0)
    s.add_argument("--interval", type=float, default=2.0)
    s.set_defaults(func=cmd_send)

    u = sub.add_parser("run", help="sends a command, waits, returns exit code + output")
    u.add_argument("id", type=int)
    u.add_argument("cmd", nargs="+")
    u.add_argument("-n", "--lines", type=int, default=60)
    u.add_argument("--timeout", type=float, default=120.0)
    u.set_defaults(func=cmd_run)

    ak = sub.add_parser("ask", help="a prompt to a CLI agent, in a throwaway window")
    ak.add_argument("prompt", nargs="+")
    ak.add_argument("--agent", choices=["claude", "copilot"], default="claude")
    ak.add_argument("--model", help="claude: opus|fable|sonnet — copilot: claude-opus-5.5")
    ak.add_argument("--reasoning", default="high", help="copilot only: --reasoning-effort")
    ak.add_argument("--dir", help="working directory of the session")
    ak.add_argument("--timeout", type=float, default=300.0)
    ak.add_argument("--keep", action="store_true", help="leaves the window open to look at it")
    ak.set_defaults(func=cmd_ask)

    c = sub.add_parser("choose", help="picks an entry of a TUI menu")
    c.add_argument("id", type=int)
    c.add_argument("what", nargs="+", help="the entry number (e.g. 2) or part of its text")
    c.add_argument("--timeout", type=float, default=20.0, help="how long to wait for the screen to change")
    c.add_argument("--csi", action="store_true", help="forza le frecce in forma CSI")
    c.set_defaults(func=cmd_choose)

    k = sub.add_parser("key")
    k.add_argument("id", type=int)
    k.add_argument("name")
    k.add_argument("--csi", action="store_true",
                   help="forces the CSI form (ESC [ B) instead of the terminfo one")
    k.set_defaults(func=cmd_key)

    n = sub.add_parser("new")
    n.add_argument("--preset", choices=sorted(PRESETS))
    n.add_argument("--cmd")
    n.add_argument("--dir")
    n.add_argument("--title", help="window name (immediately readable in list)")
    n.set_defaults(func=cmd_new)

    ti = sub.add_parser("title", help="renames the window")
    ti.add_argument("id", type=int)
    ti.add_argument("text", nargs="+")
    ti.set_defaults(func=cmd_title)

    cl = sub.add_parser("close", help="closes the window")
    cl.add_argument("id", type=int)
    cl.add_argument("--force", action="store_true", help="also terminates the processes running in it")
    cl.set_defaults(func=cmd_close)

    w = sub.add_parser("watch")
    w.add_argument("id", type=int)
    w.add_argument("-n", "--lines", type=int, default=DEFAULT_LINES)
    w.add_argument("--idle", type=float, default=4.0, help="seconds of quiet output = finished")
    w.add_argument("--timeout", type=float, default=120.0)
    w.set_defaults(func=cmd_watch)

    a = sub.add_parser("wait-for")
    a.add_argument("id", type=int)
    a.add_argument("pattern")
    a.add_argument("-n", "--lines", type=int, default=DEFAULT_LINES)
    a.add_argument("--interval", type=float, default=2.0, help="how many seconds between checks")
    a.add_argument("--timeout", type=float, default=300.0)
    a.set_defaults(func=cmd_wait_for)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
